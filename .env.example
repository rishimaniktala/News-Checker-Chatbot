# Gemini API key. Required for any real run.
GEMINI_API_KEY=
# Guardian Open Platform key. Needed for the guardian source.
GUARDIAN_API_KEY=
# Google Fact Check Tools key. Needed for the factcheck source.
FACTCHECK_API_KEY=
# Firecrawl key. Needed for the web source.
FIRECRAWL_API_KEY=

# Primary model for all roles.
MODEL_PRIMARY=gemini-3.6-flash
# Model used when the primary fails or is overloaded.
MODEL_FALLBACK=gemini-3.5-flash-lite
# Prompt set recorded on each report. Leave unset to use the code default.
PROMPT_VERSION=
# Comma list of sources: guardian, web, factcheck.
SOURCES=guardian,web,factcheck
# Max retrieval rounds per claim (1 to 3).
MAX_ITERATIONS=3
# Per-run cost cap in USD. The run stops retrieving when it is reached.
MAX_COST_USD_PER_RUN=0.05
# Check that judge quotes appear verbatim in the evidence (true/false).
ENABLE_VALIDATOR=true
# Comma list of domains the web source may return. Empty uses the built-in list.
WEB_ALLOWED_DOMAINS=
# Max web results per search.
WEB_MAX_RESULTS=5
# Requests per minute per client on the check endpoint.
RATE_LIMIT_PER_MIN=10
# Runs allowed at once. Extra requests are refused.
MAX_CONCURRENT_RUNS=2
# If set, reading stored runs requires this token. Empty means open.
RUNS_TOKEN=
# Delete stored runs older than this many days.
RUNS_RETENTION_DAYS=30
# Hours a cached retrieval result is reused.
CACHE_TTL_HOURS=24
# Path to the SQLite file for stored runs. Empty uses backend/runs.db.
NEWS_DB=
# Log level written to stdout: DEBUG, INFO, WARNING.
LOG_LEVEL=INFO
